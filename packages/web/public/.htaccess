# 9mesesfotografia.com — static site on DreamHost (Apache).

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

RewriteEngine On

# One canonical address: https://9mesesfotografia.com
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://9mesesfotografia.com%{REQUEST_URI} [L,R=301]

# One URL per page: /sobre/ and /index.html redirect to their clean form.
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Old/guessed addresses
RewriteRule ^contactos/?$ /contacto [L,R=301]
RewriteRule ^en/contacts/?$ /en/contact [L,R=301]

# Pre-rendered pages live in folders (/sobre/index.html) but are addressed
# without the trailing slash, which is also their canonical URL.
DirectorySlash Off
RewriteRule ^$ /index.html [L]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]
# Anything else is a real 404; the app shell renders the "not found" page.
RewriteRule ^ - [R=404,L]
ErrorDocument 404 /app.html

<IfModule mod_headers.c>
  # Photos and documents keep their names when replaced: cache for 30 days.
  <FilesMatch "\.(webp|jpe?g|png|svg|ico|woff2?|pdf|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HTTPS only. No includeSubDomains while webmail.* is still served over HTTP.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Everything is self-hosted; the contact form talks to EmailJS only.
  # style-src-attr covers the style="" attributes in the pre-rendered HTML.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' https://api.emailjs.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  # Apache serves .js as text/javascript: list both types or the bundle ships raw.
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Build assets carry a content hash in the name, so they can be cached forever.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
