{
  "name": "9mesesfotografia",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && bunx vite",
    "build": "cd packages/web && bunx vite build",
    "typecheck": "cd packages/web && bunx tsc --noEmit -p tsconfig.app.json",
    "images": "python3 tools/optimize-images.py"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.54.0",
    "typescript": "7.0.2"
  }
}
